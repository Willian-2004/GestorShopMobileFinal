<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:GestorShopMobile.Models"
             x:Class="GestorShopMobile.Views.ProductosPage"
             Title="Productos">
    <!-- Antes: Command="{Binding}" no apuntaba a ningún comando, por lo que al
         deslizar para refrescar el indicador quedaba girando indefinidamente. -->
    <RefreshView x:Name="Refrescar" Refreshing="OnRefrescando">
        <CollectionView x:Name="ListaProductos"
                        SelectionMode="Single"
                        SelectionChanged="OnProductoSeleccionado">
            <!-- Buscador y ayuda: se desplazan junto con la lista -->
            <CollectionView.Header>
                <VerticalStackLayout Padding="8,8,8,0">
                    <SearchBar x:Name="BuscadorProductos" Placeholder="Buscar por nombre o categoría"
                               TextChanged="OnBuscarCambiado" />
                    <Label x:Name="LblAyudaAdmin" IsVisible="False" FontSize="12" TextColor="Gray"
                           Margin="8,0,8,6"
                           Text="Toca un producto para editarlo o eliminarlo." />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Label Text="No hay productos para mostrar. Desliza hacia abajo para reintentar."
                       HorizontalTextAlignment="Center" TextColor="Gray" Margin="24" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ProductoDto">
                    <Grid Padding="16,10" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding Nombre}" FontAttributes="Bold" />
                            <Label Text="{Binding Categoria}" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End">
                            <Label Text="{Binding Precio, StringFormat='${0:0.00}'}" HorizontalTextAlignment="End" />
                            <Label Text="{Binding Stock, StringFormat='Stock: {0}'}" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
