<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:GestorShopMobile.Views"
       x:Class="GestorShopMobile.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Title="GestorShop">

    <!-- Pantalla pública: no requiere sesión -->
    <ShellContent Title="Ingresar"
                  Route="login"
                  ContentTemplate="{DataTemplate views:LoginPage}" />

    <!-- Pantallas protegidas: cada una verifica AuthService.IsAuthenticated
         en OnAppearing y redirige a "login" si no hay sesión activa
         (ver PerfilPage.xaml.cs, ProductosPage.xaml.cs, etc.) -->
    <TabBar Route="app">
        <ShellContent Title="Productos"
                      Route="productos"
                      ContentTemplate="{DataTemplate views:ProductosPage}" />
        <ShellContent Title="Nueva venta"
                      Route="nueva-venta"
                      ContentTemplate="{DataTemplate views:RegistrarVentaPage}" />
        <ShellContent Title="Historial"
                      Route="historial"
                      ContentTemplate="{DataTemplate views:HistorialVentasPage}" />
        <ShellContent Title="Perfil"
                      Route="perfil"
                      ContentTemplate="{DataTemplate views:PerfilPage}" />
    </TabBar>

</Shell>
